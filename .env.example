# Browser key. Restrict it in Google Cloud to the production hostname and only
# the Maps JavaScript / Places APIs used by this application.
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Public Supabase project configuration. Never use a service_role or sb_secret key here.
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Server-only secret used by the Cloudflare Worker.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

APP_URL="MY_APP_URL"
